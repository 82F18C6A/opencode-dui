{
  "name": "opencode-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Electron frontend for opencode",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "electron-vite build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.opencode.dui",
    "productName": "opencode-dui",
    "directories": {
      "output": "D:/Z_UserZYH/Projects/exports/opencode-dui"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "D:/Plugins/electron-45.0.0",
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@opencode/client": "^2.1.4",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "solid-js": "^1.9.17",
    "vite-plugin-solid": "^2.11.14"
  }
}
